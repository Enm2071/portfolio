# Contact form (src/pages/api/contact.ts, src/lib/contact-email.ts).
# This app's SSR runs on Vercel's Edge Runtime (edgeMiddleware: true in
# astro.config.mjs), which has no Node "net"/"tls" — so email is sent via
# Resend's plain HTTP API (fetch), not SMTP. Get a key at resend.com/api-keys.
RESEND_API_KEY=

# Address the contact form's emails are sent FROM. Either Resend's default
# onboarding@resend.dev (works instantly, no setup) or a domain you've
# verified with Resend (e.g. contacto@ernestonunez.dev).
EMAIL_FROM=onboarding@resend.dev

# Address contact-form submissions are delivered TO. Defaults to
# enm2071@gmail.com in code if unset.
CONTACT_TO_EMAIL=enm2071@gmail.com
