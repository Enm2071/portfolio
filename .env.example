# SMTP credentials for the contact form (src/pages/api/contact.ts).
# Any provider that speaks SMTP works (Resend, Gmail App Password, etc).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Address the contact form's emails are sent FROM (must be allowed by the
# SMTP provider above — e.g. a verified domain sender, or the SMTP_USER
# mailbox itself).
EMAIL_FROM=

# Address contact-form submissions are delivered TO. Defaults to
# enm2071@gmail.com in code if unset.
CONTACT_TO_EMAIL=enm2071@gmail.com
