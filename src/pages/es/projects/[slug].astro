---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import ProjectDetail from "../../../components/ProjectDetail.astro";
import { useTranslations } from "../../../i18n/utils";
import { getProjectBySlug } from "../../../data/projects";

const { slug } = Astro.params;
const t = useTranslations("es");
const meta = getProjectBySlug(slug as string);
const projectTitle = meta ? t(`${meta.i18nKey}_title` as Parameters<typeof t>[0]) : undefined;
const pageTitle = meta ? `${projectTitle} — Ernesto Nuñez Marrero` : t("project_detail_not_found_title");
const pageDescription = meta ? t(`${meta.i18nKey}_description` as Parameters<typeof t>[0]) : undefined;

const breadcrumbs = meta
	? [
			{ name: t("breadcrumb_home"), path: "" },
			{ name: t("breadcrumb_projects"), path: "/#projects" },
			{ name: projectTitle!, path: `/projects/${slug}` },
		]
	: undefined;

// Rich-result eligible: a project detail page is a portfolio work sample,
// which schema.org models as CreativeWork (tags -> keywords, the project
// image/description already computed above for OG/Twitter get reused here
// too rather than re-derived).
const structuredData = meta
	? [
			{
				"@type": "CreativeWork",
				name: projectTitle,
				description: pageDescription,
				image: meta.image,
				keywords: meta.tags.join(", "),
				url: Astro.url.href,
				creator: { "@id": `${Astro.site}#person` },
			},
		]
	: undefined;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	image={meta?.image}
	breadcrumbs={breadcrumbs}
	structuredData={structuredData}
>
	<div class="page">
		<Navbar />
		<main>
			<ProjectDetail slug={slug as string} />
		</main>
		<footer>
			<div class="footer-inner">
				<p>
					© {new Date().getFullYear()} Ernesto Nuñez Marrero. All rights reserved.
				</p>
			</div>
		</footer>
	</div>
</Layout>

<style>
	.page {
		min-height: 100vh;
		background-color: hsl(var(--background));
		color: hsl(var(--foreground));
		overflow-x: hidden;
	}

	footer {
		padding: 2rem 0;
		text-align: center;
		color: hsl(var(--muted-foreground));
		background-color: hsl(var(--background));
		border-top: 1px solid hsl(var(--border) / 0.6);
	}

	.footer-inner {
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 1rem;
		font-size: 0.875rem;
	}

	.footer-inner p {
		margin: 0;
	}
</style>
