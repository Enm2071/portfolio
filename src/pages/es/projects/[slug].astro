---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import ProjectDetail from "../../../components/ProjectDetail.astro";
import { useTranslations } from "../../../i18n/utils";
import { getProjectBySlug } from "../../../data/projects";

const { slug } = Astro.params;
const t = useTranslations("es");
const meta = getProjectBySlug(slug as string);
const pageTitle = meta
	? `${t(`${meta.i18nKey}_title` as Parameters<typeof t>[0])} — Ernesto Nuñez Marrero`
	: t("project_detail_not_found_title");
const pageDescription = meta ? t(`${meta.i18nKey}_description` as Parameters<typeof t>[0]) : undefined;
---

<Layout title={pageTitle} description={pageDescription} image={meta?.image}>
	<div class="page">
		<Navbar />
		<main>
			<ProjectDetail slug={slug as string} />
		</main>
		<footer>
			<div class="footer-inner">
				<p>
					© {new Date().getFullYear()} Ernesto Nuñez Marrero. All rights reserved.
				</p>
			</div>
		</footer>
	</div>
</Layout>

<style>
	.page {
		min-height: 100vh;
		background-color: hsl(var(--background));
		color: hsl(var(--foreground));
		overflow-x: hidden;
	}

	footer {
		padding: 2rem 0;
		text-align: center;
		color: hsl(var(--muted-foreground));
		background-color: hsl(var(--background));
		border-top: 1px solid hsl(var(--border) / 0.6);
	}

	.footer-inner {
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 1rem;
		font-size: 0.875rem;
	}

	.footer-inner p {
		margin: 0;
	}
</style>
