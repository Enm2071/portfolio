---
// Retro pixel-art icon set (pixelarticons, MIT) replacing lucide-astro's
// smooth vector icons everywhere they appear -- the site's own copy calls
// out a "retro" identity (Press Start 2P display font, "RETRO GAMING" /
// "SYNTH DESIGN" interests) that lucide's rounded-stroke icons didn't
// actually match. Raw SVGs are imported with Vite's `?raw` (each ships
// `fill="currentColor"` and `viewBox="0 0 24 24"`, same convention lucide
// used, so existing per-usage size/color CSS classes carry over
// unchanged) and inlined via set:html, since pixelarticons has no
// Astro-component export -- only raw SVG files and a separate React set.
import code from "pixelarticons/svg/code.svg?raw";
import menu from "pixelarticons/svg/menu.svg?raw";
import close from "pixelarticons/svg/close.svg?raw";
import arrowRight from "pixelarticons/svg/arrow-right.svg?raw";
import arrowLeft from "pixelarticons/svg/arrow-left.svg?raw";
import download from "pixelarticons/svg/download.svg?raw";
import info from "pixelarticons/svg/circle-info.svg?raw";
import externalLink from "pixelarticons/svg/external-link.svg?raw";
import mail from "pixelarticons/svg/mail.svg?raw";
import mapPin from "pixelarticons/svg/map-pin.svg?raw";
import phone from "pixelarticons/svg/phone.svg?raw";
import send from "pixelarticons/svg/send.svg?raw";
import layout from "pixelarticons/svg/layout.svg?raw";
import server from "pixelarticons/svg/server.svg?raw";
import globe from "pixelarticons/svg/globe.svg?raw";
import smartphone from "pixelarticons/svg/smartphone.svg?raw";
import database from "pixelarticons/svg/database.svg?raw";
import gamepad from "pixelarticons/svg/gamepad.svg?raw";
import waves from "pixelarticons/svg/waves.svg?raw";
import camera from "pixelarticons/svg/camera.svg?raw";
import terminal from "pixelarticons/svg/terminal.svg?raw";

const ICONS = {
  code,
  menu,
  close,
  "arrow-right": arrowRight,
  "arrow-left": arrowLeft,
  download,
  info,
  "external-link": externalLink,
  mail,
  "map-pin": mapPin,
  phone,
  send,
  layout,
  server,
  globe,
  smartphone,
  database,
  gamepad,
  waves,
  camera,
  terminal,
} as const;

interface Props {
  name: keyof typeof ICONS;
  class?: string;
  [attr: string]: unknown;
}

const { name, class: className = "", ...rest } = Astro.props;
---

<span class={`pixel-icon ${className}`} set:html={ICONS[name]} {...rest} />

<style>
  .pixel-icon {
    display: inline-flex;
    flex: none;
  }

  /* set:html-injected markup isn't compiled by Astro, so it never gets
     the scoped data-astro-cid attribute -- :global() is required for
     this to actually reach the inlined <svg>. */
  .pixel-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
    shape-rendering: crispEdges;
  }
</style>
