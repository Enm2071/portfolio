---
import PixelIcon from "./PixelIcon.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { projects } from "../data/projects";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects2 = projects.map((p) => ({
  slug: p.slug,
  title: t(`${p.i18nKey}_title` as Parameters<typeof t>[0]),
  description: t(`${p.i18nKey}_description` as Parameters<typeof t>[0]),
  tags: p.tags,
  image: p.image,
}));
---

<section id="projects" class="projects-section">
  <div class="projects-container">

    <!-- Header -->
    <div class="projects-header">
      <div>
        <h2 class="projects-title" set:html={t("projects_title")}></h2>

        <p class="projects-subtitle">
          {t("projects_subtitle")}
        </p>
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="projects-grid">
      {projects2.map((project, index) => (
        <div
          class="project-card animate-fade-up"
          style={`animation-delay: ${index * 0.2}s`}
        >
          <a href={`/${lang}/projects/${project.slug}`} class="card">

            <!-- Image -->
            <div class="card-image">
              <img src={project.image} alt={project.title} transition:name={`project-photo-${project.slug}`} />

              <!-- Hover Icon -->
              <div class="image-hover">
                <span class="icon-circle primary-bg">
                  <PixelIcon name="external-link" class="icon-md" />
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class="card-content">
              <h3 class="card-title" transition:name={`project-title-${project.slug}`}>{project.title}</h3>
              <p class="card-description">{project.description}</p>

              <div class="tags">
                {project.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>

          </a>
        </div>
      ))}
    </div>

    {projects2.length > 3 && (
      <div class="show-more-row">
        <button
          type="button"
          class="btn-outline show-more-btn"
          data-label-more={t("projects_showMore")}
          data-label-less={t("projects_showLess")}
          aria-expanded="false"
        >
          {t("projects_showMore")}
        </button>
      </div>
    )}

  </div>
</section>

<style>
  /* ======================================================
        SECTION BASE
  ====================================================== */
  .projects-section {
    padding: 6rem 0;
  }

  .projects-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* ======================================================
        HEADER
  ====================================================== */
  .projects-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .projects-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .projects-title {
    font-family: var(--font-display);
    letter-spacing: 0.03em;
    font-size: 2rem;
    font-weight: 800;
    color: hsl(var(--foreground));
    margin-bottom: 0.5rem;
    /* See Hero.astro's .hero-title comment: Press Start 2P renders words
       much wider than normal, so long words need to be able to break. */
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .projects-title .primary {
    color: hsl(var(--primary));
  }

  @media (min-width: 768px) {
    .projects-title {
      font-size: 3rem;
    }
  }

  .projects-subtitle {
    color: hsl(var(--muted-foreground));
    max-width: 40rem;
    line-height: 1.6;
  }

  /* ======================================================
        GRID
  ====================================================== */
  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Mobile only: collapse to the 3 most recent projects (array order) to
     cut down on scrolling, revealed via the "show more" button below. */
  @media (max-width: 767px) {
    .projects-grid:not(.show-all) .project-card:nth-child(n + 4) {
      display: none;
    }
  }

  /* ======================================================
        SHOW MORE
  ====================================================== */
  .show-more-row {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .show-more-row {
      display: none;
    }
  }

  .show-more-btn {
    background: hsl(var(--card) / 0.35);
    padding: 0.8rem 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid hsl(var(--border) / 0.7);
    color: hsl(var(--foreground));
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    backdrop-filter: blur(4px);
  }

  /* ======================================================
        CARD
  ====================================================== */
  .project-card {
    opacity: 0;
    transform: translateY(24px);
  }

  .card {
    background: hsl(var(--card) / 0.35);
    backdrop-filter: blur(12px);
    border: 1px solid hsl(var(--border) / 0.7);
    border-radius: 1rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow .3s ease;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .card:hover {
    box-shadow: 0px 10px 25px rgba(0,0,0,0.4);
  }

  /* ======================================================
        CARD IMAGE
  ====================================================== */
  .card-image {
    position: relative;
    height: 12rem;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }

  .card-image:hover img {
    transform: scale(1.1);
  }

  .image-hover {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.45);
    opacity: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    transition: opacity .3s ease;
  }

  .card-image:hover .image-hover {
    opacity: 1;
  }

  .icon-circle {
    padding: 0.75rem;
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    display: flex;
    transition: background .2s ease;
  }

  .icon-circle:hover {
    background: rgba(255,255,255,0.3);
  }

  .primary-bg {
    background: hsl(var(--primary));
  }

  .primary-bg:hover {
    background: hsl(var(--primary) / 0.9);
  }

  .icon-md {
    width: 22px;
    height: 22px;
    color: white;
  }

  /* ======================================================
        CARD CONTENT
  ====================================================== */
  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: hsl(var(--foreground));
  }

  .card-description {
    color: hsl(var(--muted-foreground));
    margin-bottom: 1.25rem;
    line-height: 1.5;
    flex-grow: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    background: rgba(255,255,255,0.07);
    border: 1px solid hsl(var(--border) / 0.7);
    border-radius: 999px;
    color: hsl(var(--foreground));
  }

  /* ======================================================
        ANIMATION
  ====================================================== */
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-up {
    animation: fade-up 0.6s ease-out forwards;
  }
</style>

<script>
  // See TechStack.astro's identical comment: astro:page-load fires after
  // initial load AND every client-side View Transitions navigation, so
  // this must run there rather than as bare top-level code.
  document.addEventListener("astro:page-load", () => {
    const grid = document.querySelector(".projects-grid");
    const btn = document.querySelector<HTMLButtonElement>(".show-more-btn");
    if (!grid || !btn) return;

    btn.addEventListener("click", () => {
      const expanded = grid.classList.toggle("show-all");
      btn.setAttribute("aria-expanded", String(expanded));
      btn.textContent = expanded ? btn.dataset.labelLess ?? btn.textContent : btn.dataset.labelMore ?? btn.textContent;
    });
  });
</script>
