---
import profileImage from "../assets/images/enm.jpeg";
import {
	Camera,
	Code,
	Gamepad2,
	Terminal,
	Waves,
} from "lucide-astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homeHref = `/${lang}/`;
const contactHref = `/${lang}/#contact`;
---

<div class="about">
	<!-- Background blobs (match landing) -->
	<div class="hero-bg" aria-hidden="true">
		<div class="blob blob-right"></div>
		<div class="blob blob-left"></div>
	</div>

	<header class="intro">
		<div class="container">
			<div class="intro-grid">
				<div class="intro-left">
					<h1 class="intro-title font-display">{t("about_page_hero_title")}</h1>
					<p class="intro-subtitle">{t("about_page_hero_subtitle")}</p>
				</div>

				<div class="intro-right">
					<div class="intro-card glass-card radius-lg">
						<img
							src={profileImage.src}
							alt="Profile"
							class="intro-img"
							loading="eager"
						/>

						<div class="intro-badge glass-card radius-md">
							<p class="badge-label">{t("about_page_based_in_label")}</p>
							<p class="badge-value">{t("about_page_based_in_value")}</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</header>

	<section class="section">
		<div class="container">
			<div class="section-head">
				<h2 class="section-title font-display">{t("about_page_journey_title")}</h2>
				<div class="section-line" aria-hidden="true" />
			</div>

			<div class="journey-grid">
				<article class="journey-card glass-card radius-lg">
					<p class="journey-number font-display">01</p>
					<h3 class="journey-title">{t("about_page_journey_1_title")}</h3>
					<p class="journey-desc">{t("about_page_journey_1_description")}</p>
					<ul class="journey-tags">
						<li>{t("about_page_journey_1_tag_1")}</li>
						<li>{t("about_page_journey_1_tag_2")}</li>
						<li>{t("about_page_journey_1_tag_3")}</li>
					</ul>
				</article>

				<article class="journey-card glass-card radius-lg">
					<p class="journey-number font-display">02</p>
					<h3 class="journey-title">{t("about_page_journey_2_title")}</h3>
					<p class="journey-desc">{t("about_page_journey_2_description")}</p>
					<ul class="journey-tags">
						<li>{t("about_page_journey_2_tag_1")}</li>
						<li>{t("about_page_journey_2_tag_2")}</li>
						<li>{t("about_page_journey_2_tag_3")}</li>
					</ul>
				</article>

				<article class="journey-card glass-card radius-lg">
					<p class="journey-number font-display">03</p>
					<h3 class="journey-title">{t("about_page_journey_3_title")}</h3>
					<p class="journey-desc">{t("about_page_journey_3_description")}</p>
					<ul class="journey-tags">
						<li>{t("about_page_journey_3_tag_1")}</li>
						<li>{t("about_page_journey_3_tag_2")}</li>
						<li>{t("about_page_journey_3_tag_3")}</li>
					</ul>
				</article>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="philo-grid">
				<div class="philo-left">
					<h2 class="section-title font-display">
						{t("about_page_philosophy_title")}
					</h2>
					<p class="philo-desc">{t("about_page_philosophy_description")}</p>

					<div class="method-grid">
						<div class="method-card glass-card radius-lg">
							<div class="method-icon" aria-hidden="true">
								<Waves class="method-svg" />
							</div>
							<div>
								<p class="method-title">{t("about_page_method_1_title")}</p>
								<p class="method-text">{t("about_page_method_1_description")}</p>
							</div>
						</div>

						<div class="method-card glass-card radius-lg">
							<div class="method-icon" aria-hidden="true">
								<Code class="method-svg" />
							</div>
							<div>
								<p class="method-title">{t("about_page_method_2_title")}</p>
								<p class="method-text">{t("about_page_method_2_description")}</p>
							</div>
						</div>
					</div>
				</div>

				<div class="philo-right">
					<div class="core-card glass-card radius-lg">
						<div class="core-visual" aria-hidden="true" />
						<div class="core-foot">
							<p class="core-title font-display">
								{t("about_page_core_methodology_title")}
							</p>
							<div class="core-badges">
								<span class="core-badge">{t("about_page_core_badge_1")}</span>
								<span class="core-badge">{t("about_page_core_badge_2")}</span>
								<span class="core-badge">{t("about_page_core_badge_3")}</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head">
				<h2 class="section-title font-display">{t("about_page_interests_title")}</h2>
				<div class="section-line" aria-hidden="true" />
			</div>

			<div class="interests-grid">
				<div class="interest-card glass-card radius-lg">
					<Gamepad2 class="interest-icon" aria-hidden="true" />
					<p class="interest-label">{t("about_page_interest_1")}</p>
				</div>
				<div class="interest-card glass-card radius-lg">
					<Code class="interest-icon" aria-hidden="true" />
					<p class="interest-label">{t("about_page_interest_2")}</p>
				</div>
				<div class="interest-card glass-card radius-lg">
					<Waves class="interest-icon" aria-hidden="true" />
					<p class="interest-label">{t("about_page_interest_3")}</p>
				</div>
				<div class="interest-card glass-card radius-lg">
					<Camera class="interest-icon" aria-hidden="true" />
					<p class="interest-label">{t("about_page_interest_4")}</p>
				</div>
				<div class="interest-card glass-card radius-lg">
					<Terminal class="interest-icon" aria-hidden="true" />
					<p class="interest-label">{t("about_page_interest_5")}</p>
				</div>
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="container">
			<div class="cta-card glass-card radius-lg">
				<div class="cta-stars" aria-hidden="true" />
				<h2 class="cta-title font-display">{t("about_page_cta_title")}</h2>
				<div class="cta-actions">
					<a class="btn-primary" href={contactHref}>{t("about_page_cta_get_in_touch")}</a>
					<a class="btn-outline" href={homeHref}>{t("about_page_cta_back_home")}</a>
				</div>
			</div>
		</div>
	</section>
</div>

<style>
	.about {
		position: relative;
		overflow: hidden;
	}

	.about .container {
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 1rem;
		position: relative;
		z-index: 10;
	}

	.about .intro {
		position: relative;
		padding: 4.25rem 0 2rem;
	}

	.about .hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	.about .blob {
		position: absolute;
		border-radius: 999px;
		filter: blur(80px);
		opacity: 0.15;
	}

	.about .blob-right {
		top: 0;
		right: 0;
		width: 520px;
		height: 520px;
		background: hsl(var(--primary));
		transform: translate(35%, -25%);
	}

	.about .blob-left {
		bottom: 0;
		left: 0;
		width: 440px;
		height: 440px;
		background: hsl(var(--purple));
		transform: translate(-30%, 25%);
	}

	.about .intro-grid {
		display: grid;
		gap: 1.75rem;
		align-items: center;
	}

	@media (min-width: 1024px) {
		.about .intro-grid {
			grid-template-columns: 1.2fr 0.8fr;
			gap: 2.5rem;
		}
	}

	.about .intro-title {
		white-space: pre-line;
		font-size: 2.25rem;
		line-height: 1.08;
		margin: 0 0 0.9rem;
		color: hsl(var(--foreground));
	}

	@media (min-width: 768px) {
		.about .intro-title {
			font-size: 3.1rem;
		}
	}

	.about .intro-subtitle {
		max-width: 70ch;
		margin: 0;
		color: hsl(var(--muted-foreground));
		font-size: 0.95rem;
		line-height: 1.7;
	}

	.about .intro-card {
		position: relative;
		overflow: hidden;
		border: 1px solid hsl(var(--border) / 0.7);
	}

	.about .intro-img {
		display: block;
		width: 100%;
		height: 260px;
		object-fit: cover;
		filter: grayscale(0.15) contrast(1.05);
	}

	@media (min-width: 1024px) {
		.about .intro-img {
			height: 280px;
		}
	}

	.about .intro-badge {
		position: absolute;
		left: 1rem;
		right: 1rem;
		bottom: 1rem;
		padding: 0.9rem 1rem;
		border: 1px solid hsl(var(--border) / 0.75);
	}

	.about .badge-label {
		margin: 0;
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		color: hsl(var(--muted-foreground));
	}

	.about .badge-value {
		margin: 0.35rem 0 0;
		font-size: 0.95rem;
		color: hsl(var(--foreground));
		font-weight: 600;
	}

	.about .section {
		padding: 2.5rem 0;
	}

	.about .section-head {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.about .section-title {
		margin: 0;
		font-size: 1.05rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: hsl(var(--foreground));
	}

	.about .section-line {
		height: 1px;
		flex: 1;
		background: hsl(var(--border));
		opacity: 0.8;
	}

	.about .journey-grid {
		display: grid;
		gap: 1.25rem;
	}

	@media (min-width: 1024px) {
		.about .journey-grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}
	}

	.about .journey-card {
		padding: 1.5rem 1.4rem;
		border: 1px solid hsl(var(--border) / 0.7);
		min-height: 260px;
	}

	.about .journey-number {
		margin: 0 0 0.75rem;
		font-size: 0.9rem;
		color: hsl(var(--muted-foreground));
	}

	.about .journey-title {
		margin: 0 0 0.75rem;
		font-size: 1.05rem;
		color: hsl(var(--foreground));
		font-weight: 700;
	}

	.about .journey-desc {
		margin: 0 0 1.25rem;
		color: hsl(var(--muted-foreground));
		line-height: 1.7;
		font-size: 0.95rem;
	}

	.about .journey-tags {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.35rem;
		color: hsl(var(--muted-foreground));
		font-size: 0.8rem;
	}

	.about .journey-tags li::before {
		content: "+ ";
		color: hsl(var(--primary));
	}

	.about .philo-grid {
		display: grid;
		gap: 1.75rem;
		align-items: start;
	}

	@media (min-width: 1024px) {
		.about .philo-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
	}

	.about .philo-desc {
		margin: 0.75rem 0 1.5rem;
		color: hsl(var(--muted-foreground));
		line-height: 1.7;
		max-width: 58ch;
	}

	.about .method-grid {
		display: grid;
		gap: 1rem;
	}

	.about .method-card {
		display: grid;
		grid-template-columns: 48px 1fr;
		gap: 0.9rem;
		align-items: start;
		padding: 1rem;
		border: 1px solid hsl(var(--border) / 0.7);
	}

	.about .method-icon {
		width: 42px;
		height: 42px;
		display: grid;
		place-items: center;
		border-radius: var(--radius-md);
		background: hsl(var(--muted) / 0.45);
		border: 1px solid hsl(var(--border) / 0.7);
	}

	.about .method-svg {
		width: 18px;
		height: 18px;
		color: hsl(var(--foreground));
		opacity: 0.9;
	}

	.about .method-title {
		margin: 0;
		font-weight: 700;
		color: hsl(var(--foreground));
		font-size: 0.95rem;
	}

	.about .method-text {
		margin: 0.25rem 0 0;
		color: hsl(var(--muted-foreground));
		line-height: 1.6;
		font-size: 0.85rem;
	}

	.about .core-card {
		position: relative;
		overflow: hidden;
		border: 1px solid hsl(var(--border) / 0.7);
		min-height: 280px;
	}

	.about .core-visual {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse at 20% 30%, hsl(var(--primary) / 0.2), transparent 60%),
			radial-gradient(ellipse at 80% 65%, hsl(var(--primary) / 0.14), transparent 55%),
			repeating-radial-gradient(
				circle at 60% 40%,
				hsl(var(--border) / 0.7),
				hsl(var(--border) / 0.7) 1px,
				transparent 1px,
				transparent 10px
			);
		opacity: 0.75;
	}

	.about .core-foot {
		position: absolute;
		left: 1.25rem;
		right: 1.25rem;
		bottom: 1.15rem;
		z-index: 1;
	}

	.about .core-title {
		margin: 0 0 0.65rem;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: hsl(var(--foreground));
	}

	.about .core-badges {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.about .core-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.3rem 0.5rem;
		border-radius: var(--radius-sm);
		border: 1px solid hsl(var(--border) / 0.8);
		background: hsl(var(--background) / 0.35);
		color: hsl(var(--foreground));
		font-size: 0.7rem;
		letter-spacing: 0.08em;
	}

	.about .interests-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.9rem;
	}

	@media (min-width: 640px) {
		.about .interests-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.about .interests-grid {
			grid-template-columns: repeat(5, 1fr);
			gap: 1rem;
		}
	}

	.about .interest-card {
		display: grid;
		place-items: center;
		gap: 0.8rem;
		padding: 1.6rem 1rem;
		border: 1px solid hsl(var(--border) / 0.7);
		text-align: center;
		min-height: 140px;
	}

	.about .interest-icon {
		width: 22px;
		height: 22px;
		color: hsl(var(--muted-foreground));
	}

	.about .interest-label {
		margin: 0;
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		color: hsl(var(--foreground));
		text-transform: uppercase;
	}

	.about .cta {
		padding: 2.25rem 0 3.25rem;
	}

	.about .cta-card {
		position: relative;
		overflow: hidden;
		border: 1px solid hsl(var(--border) / 0.7);
		padding: 2.25rem 1.5rem;
		text-align: center;
	}

	.about .cta-stars {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(hsl(var(--border) / 0.7) 1px, transparent 1px),
			radial-gradient(hsl(var(--border) / 0.45) 1px, transparent 1px);
		background-size: 26px 26px, 42px 42px;
		background-position: 0 0, 12px 16px;
		opacity: 0.25;
		pointer-events: none;
	}

	.about .cta-title {
		position: relative;
		margin: 0 0 1.35rem;
		font-size: 1.4rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: hsl(var(--foreground));
	}

	.about .cta-actions {
		position: relative;
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.about .btn-primary,
	.about .btn-outline {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.75rem 1rem;
		border-radius: var(--radius-md);
		text-decoration: none;
		font-weight: 700;
		font-size: 0.85rem;
		letter-spacing: 0.06em;
	}

	.about .btn-primary {
		background: hsl(var(--primary));
		color: hsl(var(--primary-foreground));
		border: 1px solid hsl(var(--primary) / 0.85);
	}

	.about .btn-outline {
		background: transparent;
		color: hsl(var(--foreground));
		border: 1px solid hsl(var(--border));
	}
</style>
