---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

import PixelIcon from "./PixelIcon.astro";

type SkillCategory =
  | "skills_category_frontend"
  | "skills_category_backend"
  | "skills_category_devops"
  | "skills_category_mobile"
  | "skills_category_database";

interface Skill {
  category: SkillCategory;
  icon: "layout" | "server" | "globe" | "smartphone" | "database";
  items: string[];
}

const skills: Skill[] = [
  {
    category: "skills_category_frontend",
    icon: "layout",
    items: [      "ReactJS",
      "Next.js",
      "Angular",
      "Astro",
      "Vue.js",
      "JavaScript",
      "TypeScript",
      "Material UI",
      "CSS",
      "HTML",
      "Redux",
      "Micro-Frontends"]
  },
  {
    category: "skills_category_backend",
    icon: "server",
    items: [  "Node.js",
    "Redis",
      "Express.js",
      ".NET",
      ".NET Core",
      "Python",
      "GraphQL",
      "REST APIs",
      "Golang",
      "Jest"]
  },
    {
    category: "skills_category_database",
    icon: "database",
    items: [
      "MySQL",
      "MongoDB",
      "SQL Server",
      "PostgreSQL",
      "AWS DynamoDB",
      "Firebase Firestore",
      "MariaDB",
    ]
  },
  {
    category: "skills_category_devops",
    icon: "globe",
    items: [
      "AWS Serverless",
      "AWS Lambda",
      "AWS API Gateway",
      "AWS S3",
      "AWS CloudFront",
      "AWS IAM",
      "AWS CloudWatch",
      "AWS EC2",
      "Docker",
      "CI/CD",
      "Vercel",
      "Linux",
      "GIT"
    ]
  },
  {
    category: "skills_category_mobile",
    icon: "smartphone",
    items: ["React Native", "Expo", "iOS", "Android", "Mobile UI/UX"]
  }
];
---

<section id="skills" class="skills-section">
  <div class="skills-container">

    <!-- Header -->
    <div class="skills-header">
      <h2 class="skills-title" set:html={t("skills_title")}></h2>

      <p class="skills-subtitle">
        {t("skills_subtitle")}
      </p>
    </div>

    <!-- Skills Grid -->
    <div class="skills-grid">
      {skills.map((skill, index) => (
        <div
          class="skill-card reveal"
          style={`animation-delay: ${index * 0.1}s`}
        >
          <!-- Icon -->
          <div class="skill-icon">
            <PixelIcon name={skill.icon} class="icon-md" />
          </div>

          <h3 class="skill-category">
            {t(skill.category)}
          </h3>

          <!-- Tags -->
          <div class="skill-tags">
            {skill.items.map(item => (
              <span class="tag">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>



<style>
  .skills-section {
    padding: 6rem 0;
    background: hsl(var(--card) / 0.18);
    position: relative;
  }

  .skills-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Header */
  .skills-header {
    text-align: center;
    margin-bottom: 4rem;
    max-width: 40rem;
    margin-left: auto;
    margin-right: auto;
  }

  .skills-title {
    font-family: var(--font-display);
    letter-spacing: 0.03em;
    font-size: 2rem;
    font-weight: 800;
    color: hsl(var(--foreground));
    margin-bottom: 1rem;
    /* See Hero.astro's .hero-title comment: Press Start 2P renders words
       much wider than normal, so long words need to be able to break. */
    overflow-wrap: break-word;
    word-break: break-word;
  }

  @media (min-width: 768px) {
    .skills-title {
      font-size: 3rem;
    }
  }

  .primary {
    color: hsl(var(--primary));
  }

  .skills-subtitle {
    color: hsl(var(--muted-foreground));
    line-height: 1.6;
  }

  /* Grid */
  .skills-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .skills-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Card */
  .skill-card {
    background: hsl(var(--card) / 0.35);
    border: 1px solid hsl(var(--border) / 0.7);
    backdrop-filter: blur(10px);
    padding: 1.5rem;
    border-radius: 1rem;
    transition: border-color 0.3s ease;
    opacity: 0;
    transform: translateY(24px);
  }

  .skill-card:hover {
    border-color: hsl(var(--primary));
  }

  /* Icon */
  .skill-icon {
    width: 3rem;
    height: 3rem;
    background: hsl(var(--primary) / 0.12);
    border-radius: 0.75rem;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 1.5rem;
    color: hsl(var(--primary));
    transition: transform 0.2s ease;
  }

  .skill-card:hover .skill-icon {
    transform: scale(1.1);
  }

  .icon-md {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* Category */
  .skill-category {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: hsl(var(--foreground));
  }

  /* Tags */
  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    border-radius: 999px;
    background: hsl(var(--background) / 0.22);
    border: 1px solid hsl(var(--border) / 0.7);
    color: hsl(var(--foreground));
  }

  /* Animation identical to Framer Motion */
  @keyframes fade-up {
    0% {
      opacity: 0;
      transform: translateY(24px);
      filter: blur(6px);
    }
    60% {
      opacity: 1;
      transform: translateY(-4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  .reveal.in-view {
    animation: fade-up 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
</style>

<script>
  // Intersection observer for Framer-like animation. Runs on
  // "astro:page-load" (fires after the initial load AND after every
  // client-side View Transitions navigation) rather than as bare
  // top-level code — a plain top-level script only ever runs once per
  // hard page load, so after wiring up <ClientRouter /> a later
  // client-side navigation into this section left every .reveal card
  // stuck at its base opacity: 0 until the user forced a full reload.
  document.addEventListener("astro:page-load", () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target); // Once, like Framer
          }
        });
      },
      { threshold: 0.2 }
    );

    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  });
</script>
