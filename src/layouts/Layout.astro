---
import { ClientRouter } from "astro:transitions";
import profileImage from "../assets/images/enm.jpeg";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { supportedLangs } from "../i18n/ui";

interface Breadcrumb {
	name: string;
	path: string;
}

interface Props {
	title?: string;
	description?: string;
	image?: string;
	breadcrumbs?: Breadcrumb[];
	structuredData?: Record<string, unknown>[];
}

const { title, description, image, breadcrumbs, structuredData } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pageTitle = title ?? t("site_title");
const pageDescription = description ?? t("site_description");
const ogImage = image ?? new URL(profileImage.src, Astro.site).toString();
// Only the default profile photo (a local, build-time-processed asset) has
// known dimensions -- per-project images are external Unsplash URLs whose
// real dimensions we don't have, so og:image:width/height are omitted for
// those rather than sent wrong (a mismatched size fails OG image validators
// silently rather than erroring, which is worse than just omitting it).
const ogImageWidth = image ? undefined : profileImage.width;
const ogImageHeight = image ? undefined : profileImage.height;

// Both locale trees are structurally mirrored 1:1 (/es/x <-> /en/x), so
// the alternate-language URL for any page is just its own path with the
// leading locale segment swapped -- no per-page wiring needed. Canonical
// is built from the same normalized pieces (rather than the raw,
// sometimes-trailing-slash Astro.url.pathname) so it always exactly
// matches this page's own hreflang="{lang}" self-reference below --
// otherwise "/es" (canonical) vs "/es/" (hreflang) point at the same
// page but read as two different URLs to a strict crawler.
const pathWithoutLang = Astro.url.pathname.replace(/^\/(es|en)/, "") || "/";
const canonicalURL = new URL(`/${lang}${pathWithoutLang}`, Astro.site);
const ogLocale = lang === "es" ? "es_DO" : "en_US";
const ogLocaleAlternate = lang === "es" ? "en_US" : "es_DO";

const personSchema = {
	"@type": "Person",
	"@id": `${Astro.site}#person`,
	name: "Ernesto Nuñez Marrero",
	url: Astro.site?.toString(),
	image: ogImage,
	jobTitle: lang === "es" ? "Desarrollador Full Stack" : "Full Stack Developer",
	email: "mailto:enm2071@gmail.com",
	sameAs: ["https://www.linkedin.com/in/ernesto-nunez-marrero/"],
	address: {
		"@type": "PostalAddress",
		addressLocality: "Santo Domingo",
		addressCountry: "DO",
	},
};

const websiteSchema = {
	"@type": "WebSite",
	"@id": `${Astro.site}#website`,
	name: "Ernesto Nuñez Marrero",
	url: Astro.site?.toString(),
	inLanguage: lang === "es" ? "es-DO" : "en-US",
	author: { "@id": `${Astro.site}#person` },
};

// Breadcrumbs are opt-in per page (home has none -- it IS the root), built
// from each caller's own lang-agnostic paths so this schema always matches
// the canonical/hreflang URLs above rather than duplicating URL-building
// logic per page.
const breadcrumbSchema = breadcrumbs?.length
	? {
			"@type": "BreadcrumbList",
			itemListElement: breadcrumbs.map((crumb, index) => ({
				"@type": "ListItem",
				position: index + 1,
				name: crumb.name,
				item: new URL(`/${lang}${crumb.path}`, Astro.site).toString(),
			})),
		}
	: null;

const jsonLdGraph = {
	"@context": "https://schema.org",
	"@graph": [personSchema, websiteSchema, breadcrumbSchema, ...(structuredData ?? [])].filter(Boolean),
};
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#111418" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<link rel="canonical" href={canonicalURL} />
		{supportedLangs.map((altLang) => (
			<link rel="alternate" hreflang={altLang} href={new URL(`/${altLang}${pathWithoutLang}`, Astro.site)} />
		))}
		<link rel="alternate" hreflang="x-default" href={new URL(`/es${pathWithoutLang}`, Astro.site)} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:image" content={ogImage} />
		{ogImageWidth && <meta property="og:image:width" content={ogImageWidth.toString()} />}
		{ogImageHeight && <meta property="og:image:height" content={ogImageHeight.toString()} />}
		<meta property="og:image:alt" content={pageTitle} />
		<meta property="og:site_name" content="Ernesto Nuñez Marrero" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlternate} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={pageTitle} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
		/>
		<ClientRouter />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html {
		scroll-behavior: smooth;
	}

	/* ================================
   VARIABLES (THEME SYSTEM)
================================= */

	:root {
		/* Dark Charcoal Background */
		--background: 220 15% 8%; /* #111418 */
		--foreground: 210 20% 98%; /* #f8fafc */

		/* Glassy Cards */
		--card: 220 15% 12%;
		--card-foreground: 210 20% 98%;

		--popover: 220 15% 12%;
		--popover-foreground: 210 20% 98%;

		/* Electric Blue Accent */
		--primary: 217 91% 60%; /* #3b82f6 */
		--primary-foreground: 210 20% 98%;

		/* Secondary Accent (Purple) */
		--purple: 270 95% 66%; /* ~ #a855f7 */

		--secondary: 220 15% 18%;
		--secondary-foreground: 210 20% 98%;

		--muted: 220 15% 18%;
		--muted-foreground: 215 15% 65%;

		--accent: 217 91% 60%;
		--accent-foreground: 210 20% 98%;

		--destructive: 0 63% 31%;
		--destructive-foreground: 210 40% 98%;

		--border: 220 15% 20%;
		--input: 220 15% 20%;
		--ring: 217 91% 60%;

		--radius: 0.5rem;

		--font-sans: "Inter", sans-serif;
		--font-mono: "JetBrains Mono", monospace;
		--font-display: "Press Start 2P", var(--font-sans);

		--radius-sm: calc(var(--radius) - 4px);
		--radius-md: calc(var(--radius) - 2px);
		--radius-lg: var(--radius);
	}

	/* ================================
   BASE STYLES
================================= */

	* {
		border-color: hsl(var(--border));
	}

	body {
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
		background-color: hsl(var(--background));
		color: hsl(var(--foreground));
		margin: 0;
		padding: 0;
	}

	.font-display {
		font-family: var(--font-display);
		letter-spacing: 0.04em;
	}

	/* ================================
   UTILITIES (REPLACEMENT FOR TAILWIND)
================================= */

	/* Gradient Text */
	.text-gradient {
		background: linear-gradient(to right, #60a5fa, #a855f7);
		-webkit-background-clip: text;
		color: transparent;
	}

	/* Glass Card */
	.glass-card {
		background-color: hsl(var(--card) / 0.5);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	/* Background helpers */
	.bg-background {
		background-color: hsl(var(--background));
	}

	.bg-card {
		background-color: hsl(var(--card));
	}

	.bg-primary {
		background-color: hsl(var(--primary));
	}

	.bg-secondary {
		background-color: hsl(var(--secondary));
	}

	/* Text helpers */
	.text-foreground {
		color: hsl(var(--foreground));
	}

	.text-primary {
		color: hsl(var(--primary));
	}

	.text-muted-foreground {
		color: hsl(var(--muted-foreground));
	}

	/* Border helpers */
	.border-primary {
		border-color: hsl(var(--primary));
	}

	.border-muted {
		border-color: hsl(var(--muted));
	}

	/* Radius helpers */
	.radius-sm {
		border-radius: var(--radius-sm);
	}
	.radius-md {
		border-radius: var(--radius-md);
	}
	.radius-lg {
		border-radius: var(--radius-lg);
	}
</style>
